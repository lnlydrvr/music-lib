{
  "name": "music-lib-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:i18n-keys": "tsc --noEmit -p tsconfig.i18n.json",
    "check:locales": "python3 ../scripts/check_locales.py --locales src/locales",
    "check:copy": "python3 ../scripts/check_copy.py --frontend src --backend ../src"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@number-flow/react": "^0.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.4.5",
    "i18next-icu": "^2.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.16",
    "react-virtuoso": "^4.18.16",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.2"
  }
}
